<?xml version="1.0" encoding="utf-8"?>
<!-- Sparade adresser och inställningar följer med säkerhetskopian och till en ny telefon. Inget lämnar telefonen på annat sätt. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
