<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Frågas bara när användaren slår på en påminnelse eller Live Update. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Exakta tider för påminnelserna. Appen begär det aldrig själv, och utan det kommer påminnelsen oftast inom några minuter. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Live Update: den pågående notisen får begäras som framhävd i Android 16 och senare. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- Alarmen läggs in igen efter omstart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:name=".SophamtningApplication"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sophamtning">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Genvägen Lägg till adress på appikonen. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Påminnelsernas alarm och knappen Utställt i notisen. -->
        <receiver
            android:name=".reminders.ReminderAlarmReceiver"
            android:exported="false" />

        <!-- Live Updatens start, knappen Klart och bortsvepningen. -->
        <receiver
            android:name=".reminders.LiveUpdateReceiver"
            android:exported="false" />

        <!-- Alarmen läggs in igen efter omstart, ändrad tid eller tidszon, en appuppdatering och ändrade exakta alarm. -->
        <receiver
            android:name=".reminders.RescheduleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Widgeten Nästa tömning på hemskärmen. -->
        <receiver
            android:name=".widget.NextPickupWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_pickup_widget" />
        </receiver>

        <!-- Widgeten byter dag vid midnatt i Stockholm. -->
        <receiver
            android:name=".widget.MidnightReceiver"
            android:exported="false" />

        <!-- Rutan Ställ ut kärlen i snabbinställningarna. -->
        <service
            android:name=".tile.PlaceOutTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_place_out"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <!-- Aktiv ruta: systemet binder den när appen ber om det, så att den stämmer när snabbinställningarna öppnas. -->
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>
    </application>
</manifest>
